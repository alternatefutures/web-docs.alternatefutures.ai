{
  "name": "@alternatefutures/docs",
  "version": "2.0.0",
  "description": "Documentation for Alternate Futures platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "generate:cli": "node scripts/generate-cli-docs.mjs",
    "generate:sdk": "node scripts/generate-sdk-docs.mjs"
  },
  "keywords": [
    "alternate-futures",
    "documentation",
    "cli",
    "sdk",
    "depin"
  ],
  "author": "Alternate Futures",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  },
  "dependencies": {
    "cn": "^0.2.4",
    "fumadocs-core": "16.15.8",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.8",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
