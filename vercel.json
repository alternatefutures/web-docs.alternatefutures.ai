{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "out",
  "installCommand": "pnpm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/guides/decentralized-registry", "destination": "/legacy", "permanent": true },
    { "source": "/guides/registry-architecture", "destination": "/legacy", "permanent": true },
    { "source": "/guides/registry-deployment", "destination": "/legacy", "permanent": true }
  ]
}
